<h1><%= @list.name %></h1>

<%= link_to "Add a movie", new_list_bookmark_path(@list), class: "btn btn-primary mb-3" %>

<div class="row">
  <% @list.bookmarks.each do |bookmark| %>
    <div class="col-md-3 mb-3">
      <div class="card">
        <img src="<%= bookmark.movie.poster_url %>" class="card-img-top">
        <div class="card-body">
          <h5 class="card-title"><%= bookmark.movie.title %></h5>
          <p class="card-text"><%= bookmark.comment %></p>
          <%= link_to "Remove", bookmark_path(bookmark), method: :delete, data: { turbo_confirm: "Remove this movie from the list?" }, class: "btn btn-danger btn-sm" %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<%= link_to "Back to all lists", lists_path %>
